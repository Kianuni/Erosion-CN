      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If imported wallpapers do not appear in Lock Screen editing, open \"Wallpaper Settings\" from the top-right menu, tap \"Reset Wallpaper Collections\", and try again."
          }
        },
        "zh-Hans": {
