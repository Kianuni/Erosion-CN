    "解析 systemgroup.com.apple.osanalytics 中的 .ips 诊断报告，直观定位近期被内核 Jetsam 内存保护机制查杀的应用、吃满运存的最大进程（如开启端侧 AI 后的内存压力）以及后台守护进程崩溃原因。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parses .ips diagnostic reports in systemgroup.com.apple.osanalytics to pinpoint apps recently terminated by kernel Jetsam memory protection, top memory-consuming processes (such as RAM pressure from on-device AI), and background daemon crash causes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解析 systemgroup.com.apple.osanalytics 中的 .ips 诊断报告，直观定位近期被内核 Jetsam 内存保护机制查杀的应用、吃满运存的最大进程（如开启端侧 AI 后的内存压力）以及后台守护进程崩溃原因。"
          }
        }
      }
    },
