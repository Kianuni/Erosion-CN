    "注：Apple Intelligence 核心大模型权重由系统受保护守护进程托管于 MobileAsset 只读卷中，此处统计可读的系统翻译、语音备忘录转写与视觉分析容器资产缓存。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: Core Apple Intelligence foundation model weights are managed by protected system daemons on read-only MobileAsset volumes; this view counts readable asset caches for Translate, Voice Memos transcription, and Visual Intelligence containers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注：Apple Intelligence 核心大模型权重由系统受保护守护进程托管于 MobileAsset 只读卷中，此处统计可读的系统翻译、语音备忘录转写与视觉分析容器资产缓存。"
          }
        }
      }
    },
    "注：iOS 26/27 下解除 green-tea 同样会隐藏国行单应用“不允许联网”菜单": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note: Unlocking green-tea on iOS 26/27 also hides the Mainland China (CH/A) per-app \"Off\" network access option"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
